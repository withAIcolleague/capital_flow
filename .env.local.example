# Copy this file to .env.local and fill in your API keys.
# Keys with NEXT_PUBLIC_ prefix are exposed to the browser — use server-side routes for sensitive calls.

# Alpha Vantage — stock market data (https://www.alphavantage.co)
NEXT_PUBLIC_ALPHA_VANTAGE_API_KEY=

# FRED — US economic data (https://fred.stlouisfed.org/docs/api/api_key.html)
NEXT_PUBLIC_FRED_API_KEY=

# CoinGecko — crypto data. Leave blank to use free public endpoints (no key needed).
NEXT_PUBLIC_COINGECKO_API_KEY=

# Nasdaq Data Link (https://data.nasdaq.com)
NEXT_PUBLIC_NASDAQ_API_KEY=

# Polygon.io — real-time stock data (https://polygon.io)
NEXT_PUBLIC_POLYGON_API_KEY=

# Finnhub — stocks, crypto, news (https://finnhub.io)
NEXT_PUBLIC_FINNHUB_API_KEY=

# CoinDesk — crypto price data
NEXT_PUBLIC_COINDESK_API_KEY=
